# Example environment for Cloudera-hosted LLMs via LiteLLM.
# Copy to .env (never commit secrets) and fill values from Cloudera AI Inference Model Endpoint Details.

# --- Prefer LiteLLM proxy in front of Cloudera ---
RCR_USE_MOCK_LLM=false
LITELLM_API_BASE=http://localhost:4000
LITELLM_API_KEY=sk-rcr-local
LITELLM_MODEL=cloudera-chat
LITELLM_EMBED_MODEL=cloudera-embed
LITELLM_MASTER_KEY=sk-rcr-local

# --- Cloudera AI Inference Service (used by the proxy container) ---
# base_url must end at /v1 (strip trailing /chat/completions if copied from UI)
CLOUDERA_AI_INFERENCE_API_BASE=https://YOUR_DOMAIN/namespaces/serving-default/endpoints/YOUR_ENDPOINT/v1
CLOUDERA_AI_INFERENCE_MODEL=YOUR_REGISTRY_MODEL_NAME
CLOUDERA_AI_INFERENCE_EMBED_API_BASE=https://YOUR_DOMAIN/namespaces/serving-default/endpoints/YOUR_EMBED_ENDPOINT/v1
CLOUDERA_AI_INFERENCE_EMBED_MODEL=YOUR_EMBED_MODEL_NAME

# Workload auth token (or set CLOUDERA_AI_INFERENCE_API_KEY)
CDP_TOKEN=

# OpenSearch (optional)
RCR_USE_OPENSEARCH=false
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
# Set to your embedding dimension when using a real embed model (e.g. 768 / 1024 / 3072)
OPENSEARCH_EMBED_DIM=8

# Optional per-role models (different LLMs / endpoints)
# RCR_MODEL_PROFILE=split-direct
# RCR_LLM_AGENT_ROUTER=false
# LITELLM_MODEL_PLANNER=nvidia/nemotron-3-super-120b-a12b
# LITELLM_MODEL_SEARCHER=nvidia/nemotron-3-super-120b-a12b
# LITELLM_MODEL_RECOMMENDER=nvidia/nemotron-3-super-120b-a12b
# CLOUDERA_AI_INFERENCE_API_BASE_PLANNER=
# CLOUDERA_AI_INFERENCE_API_BASE_SEARCHER=
# CLOUDERA_AI_INFERENCE_API_BASE_RECOMMENDER=
